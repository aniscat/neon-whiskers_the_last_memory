{
  "name": "neon-whiskers-the-last-memory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Juego de plataformas 2D cyberpunk narrativo con un agente IA (MOTHER) que usa tool use.",
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"vite\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "tsx scripts/copy-assets.ts"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "phaser": "^3.90.0",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}

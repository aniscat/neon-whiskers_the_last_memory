# Copia este archivo a `.env` y rellena la clave.
# La clave SOLO se lee en el servidor (server/), nunca entra en el bundle del cliente.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=8787

# Iteraciones máximas del bucle de tool use del agente.
AGENT_MAX_STEPS=6
# Timeout total por turno de diálogo, en milisegundos.
AGENT_TIMEOUT_MS=25000
